{
  "opencollection": "1.0.0",
  "info": {
    "name": "Trakt Calendars Lists API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Lists",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Trending Lists",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.trakt.tv/lists/trending"
          },
          "docs": "Get Trending Lists"
        },
        {
          "info": {
            "name": "Get Popular Lists",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.trakt.tv/lists/popular"
          },
          "docs": "Get Popular Lists"
        }
      ]
    }
  ],
  "bundled": true
}